# Copy to backend/.env for local development. Never commit real values.
DATABASE_URL=postgresql://resume_user:change-me@127.0.0.1:5433/resume_db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECRET_KEY=replace-with-a-long-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
OPENAI_API_KEY=
MAX_UPLOAD_BYTES=10485760
EMAIL_PROVIDER=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=
RECRUITER_CONTACT_EMAIL=
MAX_INVITATION_BATCH_SIZE=50
UPLOAD_DIR=uploads
VECTOR_DATA_DIR=vector_data
HF_HOME=/root/.cache/huggingface
